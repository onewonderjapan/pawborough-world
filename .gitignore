# Shared / machine-local artifacts — never commit
node_modules
node_modules/
.zcode/
dist/
.cache/
*.log
logs/
*.pid

# Task-local test sandboxes (created per-run by validator/negative tests)
sandbox*/
tmp/
.night-runner-state

# OS / editor noise
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# C4: dist-compressed/ is a build output — reproduce with tools/build_compressed_dist.mjs
# (its sources: committed world/**/ *.cm.glb + *.cm.json + the dist/ baseline)
dist-compressed/
# player-experience batch A: verification build output (fresh outDir per run)
dist-player-exp-a/

# candidate dist build outputs (rebuildable via scripts/build_lane_a_polish_dist.mjs)
dist-*/
# Blender save backups (*.blend stays tracked as the reopenable source)
*.blend1

# world-playable-night restore-verify dir (kept on disk, not committed)
restore-world-playable/

# world-playable-night: the ZIP stays on disk, digest receipt is committed
artifacts/world-playable/delivery/*.zip
